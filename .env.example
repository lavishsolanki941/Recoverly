# Recoverly — environment variables (example)
# Copy to .env and fill in real values. NEVER commit .env.
# NEVER prefix a secret with NEXT_PUBLIC_ — only RAZORPAY_KEY_ID may be public.

# --- Database (Neon Postgres connection string) ---
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# --- Razorpay TEST MODE (dashboard.razorpay.com -> Test Mode -> Settings -> API Keys) ---
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
# Set the same value in the Razorpay dashboard's webhook configuration.
RAZORPAY_WEBHOOK_SECRET="a-random-string-you-choose"

# --- Google Gemini (Google AI Studio) ---
GEMINI_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxx"

# --- Cron ---
# Protects POST /api/cron/process-retries; also sent by Vercel Cron as a header.
CRON_SECRET="a-random-string-you-choose"

# --- NextAuth ---
NEXTAUTH_SECRET="a-random-string-you-choose"
NEXTAUTH_URL="http://localhost:3000"

# --- Demo login (single seeded merchant account) ---
DEMO_EMAIL="demo@recoverly.dev"
DEMO_PASSWORD="change-me"

# --- Demo tooling ---
# Enables POST /api/demo/simulate-failure and the dashboard's demo buttons.
# Leave unset/false on a real deployment.
DEMO_MODE="true"
